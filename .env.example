# Ejemplo de configuracion de entorno
# NO contiene credenciales reales — solo valores de ejemplo

# Base de datos (desarrollo local con Postgres en docker-compose)
DATABASE_URL=postgresql+psycopg2://perfil_user:perfil_pass@localhost:5432/perfil_db

# Configuracion de CNE / scraping (si se utilizan)
CNE_BASE_URL=https://...
CV_SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PerfilProfesionalizacionBot/1.0)

# Otros parametros opcionales
ENVIRONMENT=development
